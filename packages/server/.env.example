# DomeForms Server Environment Configuration
# Copy this file to .env and modify as needed

# Application
NODE_ENV=development
PORT=3000

# Database - PostgreSQL (default/recommended)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/domeforms?schema=public"
DATABASE_TYPE=postgresql

# Database - MySQL (alternative)
# DATABASE_URL="mysql://domeforms:domeforms@localhost:3306/domeforms"
# DATABASE_TYPE=mysql

# Database - MariaDB (MySQL-compatible fork)
# DATABASE_URL="mariadb://domeforms:domeforms@localhost:3307/domeforms"
# DATABASE_TYPE=mariadb

# Database - SQLite (local development only)
# DATABASE_URL="file:./data/domeforms.db"
# DATABASE_TYPE=sqlite

# Database - SQL Server (Microsoft)
# DATABASE_URL="sqlserver://localhost:1433;database=domeforms;username=sa;password=DomeForms@2024!;trustServerCertificate=true;encrypt=false"
# DATABASE_TYPE=sqlserver

# Redis Cache
REDIS_URL="redis://localhost:6379"

# File Storage (MinIO/S3 compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=domeforms
MINIO_USE_SSL=false

# Authentication
BETTER_AUTH_SECRET="a_random_32_character_secret_string_here_12345"
BETTER_AUTH_URL="http://localhost:3000"

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="noreply@domeforms.local"

# Frontend URLs
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Payment Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS Integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email Service APIs
SENDGRID_API_KEY=
MAILGUN_API_KEY=
