# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/domeforms?schema=public"

# Redis (for BullMQ queues)
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible file storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="domeforms"
MINIO_USE_SSL="false"

# Auth (Better-auth)
BETTER_AUTH_SECRET="your-super-secret-key-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Email (for notifications)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@domeforms.local"

# App
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# External APIs (add as needed)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal Payment Gateway (optional)
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET_KEY=""
PAYPAL_MODE="sandbox"
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""